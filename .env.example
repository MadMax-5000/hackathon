# Copy this file to .env.local and fill in your DeepSeek key.
# .env.local is gitignored (see *.local in .gitignore) and is read by the
# Vite server proxy only — the key is never sent to the browser.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Enables automatic email sending from the contact hub via Resend.
# Leave blank to keep email manual (the mailto: hand-off always works).
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM="Inspection Desk <inspection@your-verified-domain.com>"  # overrides RESEND_FROM_EMAIL
# RESEND_REPLY_TO=replies@your-verified-domain.com

# Optional. Verifies Resend delivery webhooks at POST /api/webhooks/resend.
# RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Optional. Path to the local prototype SQLite database.
# Defaults to data/c03.sqlite. Tests always use their own temporary file.
# C03_DB_PATH=data/c03.sqlite
